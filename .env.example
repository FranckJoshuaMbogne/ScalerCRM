# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings > API). The anon key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this deployment, used in invitation and email links.
# Leave empty locally; set to https://app.yourdomain.com in production.
NEXT_PUBLIC_SITE_URL=

# Server only. Used by background jobs and webhooks, never imported in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Sprint 3), sent through Resend. Leave empty to turn email off:
# invitations are then shared as links, and reminder emails wait unsent.
RESEND_API_KEY=
EMAIL_FROM="SCALER <notifications@yourdomain.com>"

# Shared secret for the background job route GET /api/cron/tasks (at least 16 characters).
# The scheduler sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# WhatsApp (Sprint 5). SCALER's Meta app, owned by Springs 360 (ADR 0002).
# Webhook URL to give Meta: https://<your-domain>/api/webhooks/whatsapp
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Google Ads spend sync (Sprint 7). Each ad account is connected with its own OAuth refresh token.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v19

# Phone notifications (Sprint 9). Generate once with: node scripts/generate-vapid-keys.mjs
# Changing the keys signs everyone out of push; they turn it on again from the account menu.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@yourdomain.com

# Error reporting (Sprint 9). Leave empty to log errors to the server console only.
SENTRY_DSN=

# Subscription billing (Sprint 11). Razorpay Subscriptions; use rzp_test_ keys until go-live.
# Webhook URL to give Razorpay: https://<your-domain>/api/webhooks/billing/razorpay
# Events: subscription.authenticated, .activated, .charged, .pending, .halted, .cancelled, .completed, .updated
# Without keys, development and preview deployments use a test provider that moves no money;
# production has no online payment until the keys are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# BILLING_PROVIDER=razorpay|fake   (optional override; fake is refused in production)
